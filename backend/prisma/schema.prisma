generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
   id           String   @id @default(cuid())
   email        String   @unique
   name         String
   picture      String?
   auth0Sub     String?  @unique
   preferences  Json     @default("{}")
   createdAt    DateTime @default(now())
   updatedAt    DateTime @updatedAt
   resumes      Resume[]
   applications JobApplication[]
   coverLetters CoverLetter[]
   jobSources   JobSource[]
   scrapedJobs  ScrapedJob[]
   notifications Notification[]
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  originalName  String
  size          Int
  path          String
  extractedText String?
  structuredData Json?    // New: AI-parsed structured resume data
  createdAt    DateTime @default(now())
  analyses     ResumeAnalysis[]
  applications JobApplication[]

  @@index([userId, createdAt])
}

model ResumeAnalysis {
  id               String   @id @default(cuid())
  resumeId         String
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription   String?
  matchPercentage  Int
  skillsRadar      Json
  missingKeywords  String[]
  suggestions      String[]
  claudePrompt     String?
  claudeResponseId String?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
}

model JobApplication {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  positionTitle   String
  jobDescription  String?
  jobUrl          String?
  applicationDate DateTime?
  status          String        @default("todo")
  matchScore      Int?
  resumeId        String?
  resume          Resume?       @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetterId   String?
  coverLetter     CoverLetter?  @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  scrapedJobId    String?
  scrapedJob      ScrapedJob?   @relation(fields: [scrapedJobId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activities      Activity[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([jobUrl])
  @@unique([userId, jobUrl], map: "JobApplication_userId_jobUrl_key")
}

model Activity {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String
  description   String
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([applicationId, createdAt])
}

model CoverLetter {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId  String?
  content        String
  jobDescription String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]

  @@index([userId])
  @@index([userId, createdAt])
}

// ── New models for automated scraping ──

model JobSource {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   // e.g. "Jooble", "Indeed", "Adzuna", "Remotive", "GitHub"
  enabled    Boolean  @default(true)
  keywords   String[] // search keywords
  location   String   @default("remote")
  remoteOnly Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScrapedJob {
   id              String           @id @default(cuid())
   userId          String
   user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
   externalId      String           // source-specific ID for dedup
   source          String           // Jooble | Indeed | Adzuna | Remotive | GitHub
   title           String
   company         String
   location        String
   description     String
   url             String
   salary          String?
   postedDate      DateTime?
   matchScore      Int?
   status          String           @default("new") // new | matched | applied | skipped
   processedAt     DateTime?
   createdAt       DateTime         @default(now())
   applications    JobApplication[]

   @@unique([source, externalId]) // prevent duplicate scrapes
   @@index([userId, status, createdAt])
   @@index([userId, processedAt])
   @@index([url])
}

model Notification {
   id            String   @id @default(cuid())
   userId        String
   user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
   title         String
   message       String
   type          String   // info, warning, error, success
   relatedId     String?  // ID of related entity (job, application, etc.)
   metadata      Json     @default("{}")
   isRead        Boolean  @default(false)
   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt

   @@index([userId, createdAt])
   @@index([userId, isRead])
}
