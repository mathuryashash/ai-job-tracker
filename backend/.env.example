PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_resume_tracker"
REDIS_HOST=localhost
REDIS_PORT=6380
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Auth0 Authentication
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api
AUTH0_CLIENT_ID=your-client-id

# AI Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Job Board APIs (optional — scraper skips sources without keys)
JOOBLE_API_KEY=
INDEED_PUBLISHER_KEY=
LINKEDIN_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# JWT & Encryption
# JWT_SECRET must be set in production (min 32 characters)
JWT_SECRET=your-jwt-secret-min-32-chars
# ENCRYPTION_KEY is used to encrypt API keys at rest (generate from JWT_SECRET for production)
ENCRYPTION_KEY=

# Job Scraping Automation
JOB_SCRAPE_CRON="0 */6 * * *"
JOB_MATCH_THRESHOLD=70
