PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_resume_tracker"
REDIS_HOST=localhost
REDIS_PORT=6380
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# Authentication
JWT_SECRET=your-secret-key-here-min-32-characters
JWT_EXPIRATION=24h

# AI Provider
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Job Board APIs (optional — scraper skips sources without keys)
JOOBLE_API_KEY=
INDEED_PUBLISHER_KEY=
LINKEDIN_API_KEY=
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Job Scraping Automation
JOB_SCRAPE_CRON="0 */6 * * *"
JOB_MATCH_THRESHOLD=70