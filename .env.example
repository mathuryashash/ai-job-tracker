# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API Key (obtain from https://console.groq.com)
GROQ_API_KEY=gsk_xxx
# Must be a model your Groq account serves (llama-3.x models are retired).
# e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# ── Production CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. "*" disables credentials.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ── Upload Limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/resume_tracker
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ── Secret encryption (B1) ───────────────────────────────────────────────────
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, secrets are stored as plaintext (dev mode only).
FERNET_KEY=

# ── Automated Job Search ──────────────────────────────────────────────────────
# USAJOBS requires a free API key (Authorization-Key header) AND the email you
# registered it with in the User-Agent — see
# https://developer.usajobs.gov/guides/authentication
USAJOBS_EMAIL=you@example.com
USAJOBS_API_KEY=

# Apify (LinkedIn, Indeed, Glassdoor scrapers)
APIFY_TOKEN=apify_xxx

# Tinyfish
TINYFISH_API_KEY=tf_xxx

# JSearch (RapidAPI) and Adzuna — optional paid providers
JSEARCH_KEY=
ADZUNA_APP_ID=
ADZUNA_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://127.0.0.1:8000
