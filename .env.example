# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq API Key (obtain from https://console.groq.com)
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama3-70b-8192

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL + pgvector (WSL on port 5434)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/resume_tracker
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ── Automated Job Search ──────────────────────────────────────────────────────
# Apify (LinkedIn, Indeed, Glassdoor scrapers)
# Get token at: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_xxx

# Tinyfish job search API
# Get key at: https://tinyfish.io/dashboard
TINYFISH_API_KEY=tf_xxx

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://127.0.0.1:8000
